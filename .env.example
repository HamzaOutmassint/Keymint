# Copy this file to `.env` and adjust it. Never commit `.env`.
# Every variable is described in docs/configuration.md.

# --- Database -------------------------------------------------------------
# These defaults match the `postgres` service in docker-compose.yml and are
# for local development only. Production startup rejects them.
POSTGRES_PASSWORD="keymint"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://keymint:keymint@localhost:5432/keymint?schema=public"

# --- Authentication -------------------------------------------------------
# Generate a real value with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Behaviour ------------------------------------------------------------
# Comma-separated CIDRs of reverse proxies whose forwarding headers you trust.
TRUSTED_PROXY_CIDRS=""
# Registration also requires a working RESEND_API_KEY.
ENABLE_REGISTRATION="false"
# Set to "true" only while running `npm run db:seed` on a local database.
ALLOW_DEMO_SEED="false"
READINESS_TIMEOUT_MS="5000"

# --- Email (Resend) -------------------------------------------------------
# Needed for registration, verification, password reset and notifications.
RESEND_FROM_EMAIL="Keymint <security@your-domain.example>"
RESEND_API_KEY="replace-with-a-resend-api-key"
