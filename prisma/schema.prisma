generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  twoFactorEnabled   Boolean             @default(false)
  accounts           Account[]
  sessions           Session[]
  activityLogs       ActivityLog[]
  rateLimits         RateLimitBucket[]
  twoFactor          TwoFactor?
  passkeys           Passkey[]
  vault              Vault?
  vaultKeyEnvelopes  VaultKeyEnvelope[]
  emailChangeRequest EmailChangeRequest?

  @@map("user")
}

model EmailChangeRequest {
  id            String    @id @default(cuid())
  userId        String    @unique
  oldEmail      String
  newEmail      String
  stage         String
  tokenHash     String    @unique
  expiresAt     DateTime
  oldVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Vault {
  id                String             @id
  userId            String             @unique
  protocolVersion   Int                @default(2)
  currentKeyVersion Int                @default(1)
  syncSequence      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyEnvelopes      VaultKeyEnvelope[]
  records           VaultRecord[]
  mutations         VaultMutation[]
  keyRotation       VaultKeyRotation?

  @@unique([id, userId])
}

model VaultKeyRotation {
  id                        String                @id
  vaultId                   String                @unique
  ownerId                   String
  sourceKeyVersion          Int
  targetKeyVersion          Int
  snapshotSequence          Int
  expectedRecordCount       Int
  masterProtected           Json
  masterNonce               String
  masterCiphertext          String
  recoveryProtected         Json
  recoveryNonce             String
  recoveryCiphertext        String
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  vault                     Vault                 @relation(fields: [vaultId, ownerId], references: [id, userId], onDelete: Cascade)
  records                   VaultKeyRotationRecord[]

  @@unique([id, vaultId, ownerId])
  @@unique([vaultId, ownerId])
  @@index([ownerId, updatedAt])
}

model VaultKeyRotationRecord {
  id                String           @id @default(cuid())
  rotationId        String
  vaultId           String
  ownerId           String
  recordId          String
  sourceRevision    String
  keyVersion        Int
  envelopeVersion   Int
  payloadVersion    Int
  encryptionVersion Int
  revision          String
  state             String
  protected         Json
  nonce             String
  ciphertext        String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rotation          VaultKeyRotation @relation(fields: [rotationId, vaultId, ownerId], references: [id, vaultId, ownerId], onDelete: Cascade)

  @@unique([rotationId, recordId])
  @@index([ownerId, rotationId])
}

model VaultMutation {
  id         String   @id @default(cuid())
  vaultId    String
  ownerId    String
  mutationId String
  response   Json
  createdAt  DateTime @default(now())
  vault      Vault    @relation(fields: [vaultId, ownerId], references: [id, userId], onDelete: Cascade)

  @@unique([vaultId, mutationId])
  @@index([ownerId, vaultId])
  @@index([createdAt])
}

model VaultKeyEnvelope {
  id                String   @id @default(cuid())
  vaultId           String
  ownerId           String
  keyVersion        Int
  purpose           String
  wrapVersion       Int      @default(1)
  wrapRevision      String
  encryptionVersion Int      @default(1)
  protected         Json
  nonce             String
  ciphertext        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vault             Vault    @relation(fields: [vaultId, ownerId], references: [id, userId], onDelete: Cascade)
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([vaultId, keyVersion, purpose])
  @@index([ownerId, vaultId, keyVersion])
}

model VaultRecord {
  id                String   @id @default(cuid())
  vaultId           String
  ownerId           String
  recordId          String
  keyVersion        Int
  envelopeVersion   Int      @default(1)
  payloadVersion    Int      @default(1)
  encryptionVersion Int      @default(1)
  revision          String
  state             String
  syncSequence      Int      @default(0)
  protected         Json
  nonce             String
  ciphertext        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vault             Vault    @relation(fields: [vaultId, ownerId], references: [id, userId], onDelete: Cascade)

  @@unique([vaultId, recordId])
  @@index([ownerId, vaultId, syncSequence])
  @@index([vaultId, keyVersion, state])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  lastUsedTotpStep        Int?
  pendingSecret           String?
  pendingBackupCodes      String?
  pendingExpiresAt        DateTime?
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("twoFactor")
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([identifier, createdAt])
  @@index([value])
  @@index([expiresAt])
  @@map("verification")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  timestamp   DateTime @default(now())
  device      String
  browser     String
  os          String
  ip          String
  action      String
  description String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, action])
  @@index([timestamp])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  userId      String?
  count       Int      @default(1)
  windowStart DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, windowStart])
  @@index([userId])
  @@index([windowStart])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rateLimit")
}
