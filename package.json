{
  "name": "keymint",
  "version": "0.1.0",
  "description": "Self-hosted, end-to-end encrypted password manager built with Next.js, Better Auth, Prisma and PostgreSQL.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamzaOutmassint/Keymint.git"
  },
  "bugs": {
    "url": "https://github.com/HamzaOutmassint/Keymint/issues"
  },
  "homepage": "https://github.com/HamzaOutmassint/Keymint#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prestart": "npm run production:check",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:retention": "tsx --env-file-if-exists=.env scripts/enforce-retention.ts",
    "production:check": "tsx scripts/validate-production.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.23",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "argon2": "^0.45.2",
    "better-auth": "^1.7.12",
    "csv-parse": "^7.0.3",
    "canonicalize": "5.1.0",
    "csv-stringify": "^6.9.0",
    "hash-wasm": "4.13.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "resend": "^6.38.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@better-auth/core": "1.7.12",
    "@better-fetch/fetch": "1.3.2",
    "next": {
      "postcss": "8.5.25"
    },
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "vite": "8.3.4"
  }
}
